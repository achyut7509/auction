{
    "name": "JoinRequest",
    "type": "object",
    "properties": {
      "room_id": {
        "type": "string"
      },
      "user_id": {
        "type": "string"
      },
      "display_name": {
        "type": "string"
      },
      "requested_team": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "PENDING",
          "APPROVED",
          "REJECTED",
          "BANNED"
        ],
        "default": "PENDING"
      },
      "role": {
        "type": "string",
        "enum": [
          "BIDDER",
          "SPECTATOR"
        ],
        "default": "BIDDER"
      },
      "team_id": {
        "type": "string"
      }
    },
    "required": [
      "room_id",
      "display_name"
    ]
  }